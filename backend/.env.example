# Copy this file to .env and fill in real values for local dev.
# Never commit the real .env file — it's already in .gitignore.

# Local dev default (SQLite, zero setup required):
DATABASE_URL=sqlite:///./career_platform.db

# Production example (PostgreSQL, e.g. on Render/Supabase):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/career_platform

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_this_is_only_for_local_dev

ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
DEBUG=true

# Optional — enables LLM-assisted recovery for messy/unstructured resumes
# (see docs/messy_resume_recovery.md). Leave unset and the app works fine
# with pure rule-based parsing; no code changes needed either way.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
